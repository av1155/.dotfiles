[user]
	name = Andrea Arturo Venti Fuentes
    email = 117413846+av1155@users.noreply.github.com

[core]
    editor = code --wait
    autocrlf = input
    excludesfile = ~/.gitignore_global
    pager = delta

[init]
    defaultBranch = main

[alias]
    count = !git ls-remote --heads origin | wc -l
    lg = log --graph --oneline --decorate --all

[push]
    default = current

[rebase]
    autosquash = true

[merge]
    conflictStyle = zdiff3

[diff]
    algorithm = histogram
    colorMoved = default

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    line-numbers = true

# Agent commit gates; see ~/.agents/skills/refine and build-loop. Pause with refine.mode = off.
# The test keeps human commits and pushes from ever starting the scripts.
[hook "refine"]
    event = pre-commit
    command = test -z \"$AI_AGENT$CLAUDECODE\" || ~/.agents/skills/refine/scripts/refine gate
[hook "build-loop-tier"]
    event = pre-commit
    command = test -z \"$AI_AGENT$CLAUDECODE\" || ~/.agents/skills/build-loop/scripts/bl check-tier
[hook "build-loop-ledger"]
    event = pre-push
    command = test -z \"$AI_AGENT$CLAUDECODE\" || ~/.agents/skills/build-loop/scripts/bl check-ledger

[refine]
    mode = block
    agents = claude-code

[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
