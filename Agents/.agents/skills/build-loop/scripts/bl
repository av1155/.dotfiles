#!/usr/bin/env -S python3 -B
"""Per-branch state for the build-loop skill, plus its warn-only git hooks.

Usage: bl {state,tier,plan,round,ending,reset,context,check-tier,check-ledger} ...

State and plan live in $(git rev-parse --git-common-dir)/build-loop/<branch>/, so
they survive reboots and are shared by worktrees; reset moves a finished change's
directory into build-loop/.archive/. check-tier (pre-commit) and check-ledger
(pre-push) only warn and always exit 0; check-tier stays quiet on docs-only
commits, and check-ledger checks the branches being pushed. context reads the
session's context use from its Claude Code transcript; context plan and context
round print only that checkpoint's verdict, with numbers only at or past its limit, and
continue in an unattended session, where nobody can run /compact. Git config:
buildloop.checks (warn|off, default warn), buildloop.agents (AI_AGENT prefixes,
default claude-code), buildloop.contextWindow (default 1000000),
buildloop.compactAfterPlan and buildloop.compactBeforeRound (percent, default 25
and 60). Needs Python 3.11 or later.

Exit codes: 0 success; 1 a failed command; 2 invalid usage, lowering a tier
without --force, retiering a finished change without --reopen, a round number
that is not the next one, a result for a loop that has ended, a documentation-wave
ending on another change, or resetting open loops without --force.
"""

import argparse
import datetime as dt
import json
import os
import re
import sys
from pathlib import Path
from typing import cast

import bl_context
import bl_state as core

COMPACT_POINTS = {
    "plan": ("after planning", "buildloop.compactAfterPlan", 25),
    "round": ("before a round", "buildloop.compactBeforeRound", 60),
}

DOC_SUFFIXES = (".md", ".mdx", ".markdown", ".rst", ".adoc", ".txt")
DOC_NAME = re.compile(
    r"(LICEN[CS]E|NOTICE|AUTHORS|COPYING|CHANGELOG)([-_.][A-Z0-9][A-Z0-9.-]*)?"
)
DEPENDENCY_LIST = re.compile(
    r"(.*/)?(requirements/[^/]+|[\w.-]*(requirements|constraints)[\w.-]*)\.txt"
)


def _print_state(state: dict[str, object]) -> None:
    print(f"branch: {state['branch']}")
    print(f"updated: {state.get('updated') or 'never'}")
    wave = " (documentation wave)" if state["docs_wave"] else ""
    print(f"tier: {state['tier'] or 'not set'}{wave} {state['reason'] or ''}".rstrip())
    print(f"base: {state['base'] or 'not recorded'}")
    print(f"plan: {state['plan'] or 'not recorded'}")
    print(f"rounds: {len(cast('list[object]', state['rounds']))}")
    for name in core.LOOPS:
        loop = core.loop(state, name)
        ending = loop["ending"] or "open"
        print(
            f"{name}: {loop['passes']} passes, {loop['clean']} clean, ending: {ending}"
        )
    print(f"next: {core.next_step(state)}")


def cmd_state(args: argparse.Namespace) -> int:
    state = core.load(core.current_branch())
    if args.json:
        print(json.dumps(state, indent=2))
    else:
        _print_state(state)
    return 0


def _refuse(command: str, message: str) -> int:
    print(f"bl {command}: {message}", file=sys.stderr)
    return 2


def cmd_tier(args: argparse.Namespace) -> int:
    state = core.load(core.current_branch())
    current = state["tier"]
    if core.finished(state) and not args.reopen:
        return _refuse(
            "tier",
            "the last change on this branch has rounds and both loop endings. Run bl "
            "reset, then bl tier (with --base <the commit before the new change> if "
            "it is already committed), or pass --reopen to retier this one.",
        )
    order = core.TIERS.index
    lowering = isinstance(current, str) and order(args.tier) < order(current)
    if lowering and not args.force:
        return _refuse(
            "tier",
            f"{current} is already recorded. Lower it only when the user says so, "
            "then pass --force.",
        )
    if args.base:
        base = core.optional_git(
            "rev-parse", "--verify", "--quiet", f"{args.base}^{{commit}}"
        )
        if not base:
            message = f"--base {args.base} is not a commit"
            raise core.LoopError(message)
        state["base"] = base
    elif not state["base"]:
        state["base"] = core.head()
    state["tier"], state["reason"] = args.tier, args.reason
    if args.docs_wave:
        state["docs_wave"] = True
    for name in core.LOOPS:
        core.settle(state, name)
    core.save(state)
    print(f"tier {args.tier} recorded for {state['branch']}")
    return 0


def cmd_plan(args: argparse.Namespace) -> int:
    branch = core.current_branch()
    if args.path or not args.file:
        target = core.branch_dir(branch) / "plan.md"
        target.parent.mkdir(parents=True, exist_ok=True)
        print(target)
        return 0
    state = core.load(branch)
    state["plan"] = str(Path(args.file).expanduser().resolve())
    core.save(state)
    print(f"plan recorded: {state['plan']}")
    return 0


def cmd_round(args: argparse.Namespace) -> int:
    state = core.load(core.current_branch())
    if state["tier"] not in core.CAPS:
        message = "record a tier of T1 or higher before counting rounds"
        raise core.LoopError(message)
    rounds = cast("list[object]", state["rounds"])
    if args.round != len(rounds) + 1:
        return _refuse(
            "round",
            f"round {args.round} does not follow the {len(rounds)} on record; check "
            "bl state before recording again.",
        )
    pending = core.open_loops(state)
    for name, result in (("review", args.review), ("audit", args.audit)):
        if result != "done" and name not in pending:
            return _refuse(
                "round",
                f"the {name} loop has an ending, so pass --{name} done, or reopen it "
                f"first: bl ending --loop {name} --token 'in progress'.",
            )
    rounds.append(
        {
            "at": core.now(),
            "review": args.review,
            "audit": args.audit,
            "note": args.note,
        }
    )
    core.record(state, "review", args.review)
    core.record(state, "audit", args.audit)
    core.save(state)
    _print_state(state)
    return 0


def cmd_ending(args: argparse.Namespace) -> int:
    state = core.load(core.current_branch())
    if args.token == "documentation wave" and not state["docs_wave"]:
        return _refuse(
            "ending",
            "this change is not a documentation wave; declare one when recording the "
            "tier: bl tier <T> --reason '<why>' --docs-wave.",
        )
    core.set_ending(state, args.loop, args.token)
    core.save(state)
    print(f"{args.loop} ending: {args.token}")
    return 0


def cmd_reset(args: argparse.Namespace) -> int:
    branch = core.current_branch()
    current = core.branch_dir(branch)
    if not current.exists():
        print(f"no build-loop state for {branch}")
        return 0
    state = core.load(branch)
    if state["rounds"] and core.open_loops(state) and not args.force:
        return _refuse(
            "reset",
            "a loop on this branch is still open (see bl state); end it first, or "
            "pass --force to archive it anyway.",
        )
    stamp = dt.datetime.now(dt.UTC).strftime("%Y%m%dT%H%M%S%fZ")
    # Git ref components never start with a dot, so no branch directory collides.
    archive = current.parent / ".archive" / f"{current.name}-{stamp}"
    archive.parent.mkdir(parents=True, exist_ok=True)
    current.rename(archive)
    print(f"archived the build-loop state for {branch} to {archive}")
    return 0


def _config_int(key: str, default: int) -> int:
    value = core.optional_git("config", "--get", key)
    if value.isdecimal() and int(value) > 0:
        return int(value)
    if value:
        print(f"bl: ignoring {key}={value}; using {default}", file=sys.stderr)
    return default


def cmd_context(args: argparse.Namespace) -> int:
    if args.point and os.environ.get("CLAUDE_CODE_SESSION_ATTENDED") == "0":
        print("continue")
        return 0
    reading = bl_context.tokens(bl_context.transcript())
    window = _config_int("buildloop.contextWindow", 1_000_000)
    share, detail = 0, "no request logged yet, so this session just started"
    if reading is not None:
        used, compacted = reading
        share = 100 * used // window
        carried = " carried over by a compaction" if compacted else ""
        detail = f"{used:,} tokens{carried}, {share}% of a {window:,}-token window"
    if args.point:
        _label, key, default = COMPACT_POINTS[args.point]
        limit = _config_int(key, default)
        print(f"compact: {detail} (limit {limit}%)" if share >= limit else "continue")
        return 0
    print(f"context: {detail}")
    for label, key, default in COMPACT_POINTS.values():
        limit = _config_int(key, default)
        verdict = "compact" if share >= limit else "continue"
        print(f"{label}: {verdict} (compacts at {limit}%)")
    return 0


def _checks_active() -> bool:
    fallback = "claude-code" if os.environ.get("CLAUDECODE") == "1" else ""
    agent = os.environ.get("AI_AGENT") or fallback
    if not agent or core.optional_git("config", "--get", "buildloop.checks") == "off":
        return False
    allowed = core.optional_git("config", "--get-all", "buildloop.agents")
    prefixes = re.split(r"[\s,]+", allowed or "claude-code")
    return any(agent.startswith(prefix) for prefix in prefixes if prefix)


def _quiet_load(branch: str) -> dict[str, object] | None:
    try:
        return core.load(branch)
    except core.LoopError:
        return None


def _is_doc(path: str) -> bool:
    name = path.rsplit("/", 1)[-1]
    prose = (
        name.lower().endswith(DOC_SUFFIXES)
        and name != "CMakeLists.txt"
        and not DEPENDENCY_LIST.fullmatch(path)
    )
    return prose or DOC_NAME.fullmatch(name) is not None


def _docs_only() -> bool:
    staged = core.optional_git("diff", "--cached", "--name-only", "-z").split("\0")
    paths = [path for path in staged if path]
    return bool(paths) and all(_is_doc(path) for path in paths)


def cmd_check_tier(_args: argparse.Namespace) -> int:
    if not _checks_active():
        return 0
    state = _quiet_load(core.current_branch())
    if state is None or state["tier"] is not None or _docs_only():
        return 0
    head = core.head()
    base = f" --base {head}" if head else ""
    print(
        f"build-loop (warn): no tier recorded for {state['branch']}. The main session "
        "picks one with the build-loop skill and records it: bl tier <T0|T1|T2|T3> "
        f"--reason '<why>'{base}. A subagent leaves this to the session that launched "
        "it.",
        file=sys.stderr,
    )
    return 0


def _pushed_branches() -> list[str]:
    if sys.stdin.isatty():
        return [core.current_branch()]
    branches: list[str] = []
    for line in sys.stdin.read().splitlines():
        ref = line.split(" ", 1)[0]
        if ref == "HEAD":
            branches.append(core.current_branch())
        elif ref.startswith("refs/heads/"):
            branches.append(ref.removeprefix("refs/heads/"))
    return branches


def cmd_check_ledger(_args: argparse.Namespace) -> int:
    if not _checks_active():
        return 0
    for branch in _pushed_branches():
        state = _quiet_load(branch)
        if state is None or state["tier"] not in core.CAPS:
            continue
        pending = core.open_loops(state)
        if pending:
            print(
                f"build-loop (warn): pushing {branch} before these loops have an "
                f"ending: {', '.join(pending)}. Push once, after both loops end, "
                "unless the user asked for an early push.",
                file=sys.stderr,
            )
    return 0


def _parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="bl", description="Build-loop state and checks."
    )
    commands = parser.add_subparsers(dest="command", required=True)
    state = commands.add_parser("state", help="show this branch's loop state")
    state.add_argument("--json", action="store_true")
    state.set_defaults(func=cmd_state)
    tier = commands.add_parser("tier", help="record the risk tier")
    tier.add_argument("tier", choices=core.TIERS)
    tier.add_argument("--reason", required=True)
    tier.add_argument(
        "--base", help="the commit before the change, when tiering after committing"
    )
    tier.add_argument(
        "--force", action="store_true", help="lower a tier the user approved"
    )
    tier.add_argument(
        "--reopen", action="store_true", help="retier a change whose loops ended"
    )
    tier.add_argument(
        "--docs-wave", action="store_true", help="suspend the clean-pass ending"
    )
    tier.set_defaults(func=cmd_tier)
    plan = commands.add_parser("plan", help="print the plan path, or record one")
    plan.add_argument("file", nargs="?")
    plan.add_argument("--path", action="store_true")
    plan.set_defaults(func=cmd_plan)
    rnd = commands.add_parser("round", help="record one round's results")
    rnd.add_argument("--round", type=int, required=True, help="this round's number")
    for loop in core.LOOPS:
        rnd.add_argument(f"--{loop}", choices=("clean", "dirty", "done"), required=True)
    rnd.add_argument("--note", default="")
    rnd.set_defaults(func=cmd_round)
    ending = commands.add_parser("ending", help="set a loop's ending token")
    ending.add_argument("--loop", choices=core.LOOPS, required=True)
    ending.add_argument("--token", choices=core.MANUAL_ENDINGS, required=True)
    ending.set_defaults(func=cmd_ending)
    reset = commands.add_parser("reset", help="archive this branch's state and plan")
    reset.add_argument("--force", action="store_true", help="archive open loops too")
    reset.set_defaults(func=cmd_reset)
    context = commands.add_parser("context", help="this session's context use")
    context.add_argument(
        "point",
        nargs="?",
        choices=tuple(COMPACT_POINTS),
        help="print only this checkpoint's verdict",
    )
    context.set_defaults(func=cmd_context)
    check_tier = commands.add_parser("check-tier", help="pre-commit hook, warn only")
    check_tier.set_defaults(func=cmd_check_tier)
    check_ledger = commands.add_parser("check-ledger", help="pre-push hook, warn only")
    check_ledger.add_argument("hook_args", nargs="*")
    check_ledger.set_defaults(func=cmd_check_ledger)
    return parser


def main(argv: list[str] | None = None) -> int:
    args = _parser().parse_args(argv)
    try:
        return int(args.func(args))
    except core.LoopError as exc:
        print(f"bl {args.command}: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
