{
    "lastChangelogVersion": "0.74.0",
    "defaultProvider": "openai-codex",
    "defaultModel": "gpt-5.6-sol",
    "defaultThinkingLevel": "xhigh",
    "theme": "catppuccin-macchiato",
    "packages": [
        "git:github.com/nicobailon/pi-subagents@d9864f8288152e83270f62090d7d66eb5ff729bb",
        "npm:pi-web-access",
        "packages/pi-statusline-footer",
        "npm:pi-lens",
        "npm:@juicesharp/rpiv-todo",
        "npm:@juicesharp/rpiv-ask-user-question",
        "npm:@juicesharp/rpiv-args",
        "npm:pi-mcp-adapter",
        "npm:@aliou/pi-processes",
        "npm:pi-simplify",
        "npm:@samfp/pi-memory",
        "npm:@plannotator/pi-extension",
        "npm:pi-claude-style-tools",
        "packages/pi-claude-style-interop",
        "npm:@spences10/pi-confirm-destructive"
    ],
    "extensions": [],
    "memory": {
        "lessonInjection": "selective"
    },
    "workingVibe": "off",
    "quietStartup": true,
    "startupScreen": {
        "enabled": true
    },
    "showLastPrompt": false,
    "powerline": {
        "fixedEditor": true,
        "mouseScroll": true,
        "widgetBudgets": {
            "widgets": {
                "pi-lens": {
                    "mode": "actionable",
                    "maxLines": 8
                },
                "rpiv-todos": {
                    "mode": "native"
                },
                "plannotator-progress": {
                    "mode": "remaining",
                    "maxLines": 4
                }
            }
        }
    }
}
